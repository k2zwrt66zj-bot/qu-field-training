# ---------- قاعدة البيانات (PostgreSQL محلي أو Supabase) ----------
# Supabase: استخدم رابط الـ Pooler (المنفذ 6543) هنا والرابط المباشر (5432) في DIRECT_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qu_field_training"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/qu_field_training"

# ---------- المصادقة ----------
# توليد مفتاح: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# الرابط المعتمد للمنصة. يحدد أمان الكوكيز فقط: https → كوكيز Secure.
# إعادة التوجيه بعد الدخول والخروج نسبية (/login…) وتبقى على نطاق الطلب الحالي أياً كانت هذه القيمة.
NEXTAUTH_URL="http://localhost:3000"
# الجلسة 30 يوماً وتمتد تلقائياً مع الاستخدام، ويُعاد التحقق من حالة الحساب كل 5 دقائق
# (إيقاف الحساب أو تغيير دوره يسري خلال دقائق). للاختبار الفوري: AUTH_USER_RECHECK_SECONDS=0
# AUTH_USER_RECHECK_SECONDS=300
# نطاق رسمي ثابت لروابط التحقق في رموز QR داخل ملفات PDF (اختياري؛ الافتراضي نطاق الطلب الحالي)
# APP_PUBLIC_URL="https://training.qu.edu.sa"

# ---------- توليد PDF الرسمي على الخادم ----------
# يُكتشف Chrome أو Edge أو Chromium تلقائياً في مساراتها المعتادة (ويندوز/ماك/لينكس).
# حدّد المسار هنا فقط إن كان مثبتاً في مكان آخر. إن لم يوجد متصفح تُفتح نسخة للطباعة (حفظ كـ PDF).
CHROME_EXECUTABLE_PATH=""

# ---------- إعدادات مكافحة التحضير الوهمي ----------
GPS_MAX_ACCURACY_METERS=100
GPS_MAX_POSITION_AGE_SECONDS=120
GPS_ENFORCE_DEVICE_BINDING=true

# ---------- المهام المجدولة ----------
CRON_SECRET="change-me"
# ---------- الشعار الرسمي (PNG/SVG داخل المشروع) ----------
LOGO_PATH="public/brand/qu-logo.png"

# ---------- تخزين المرفقات والأختام ----------
# local (قرص الخادم) أو supabase. إن تُرك فارغاً يُستخدم Supabase تلقائياً متى ضُبط SUPABASE_URL وSUPABASE_SERVICE_ROLE_KEY
# على Vercel يجب استخدام Supabase: قرص الخادم هناك مؤقت ولا تُحفظ عليه الملفات
STORAGE_DRIVER=""
STORAGE_DIR="storage"
# عند استخدام Supabase Storage (حاوية خاصة، والمفتاح يبقى على الخادم فقط)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="field-training"
MAX_UPLOAD_BYTES=5242880

# ---------- صفحة «عن المنصة والمطور» (/developer) ----------
# قنوات تواصل المطور. غير المضبوط منها يظهر زراً معطلاً «يُضاف قريباً»
DEVELOPER_EMAIL=""
DEVELOPER_LINKEDIN_URL=""
