# ---------- قاعدة البيانات (PostgreSQL محلي أو Supabase) ----------
# Supabase: استخدم رابط الـ Pooler (المنفذ 6543) هنا والرابط المباشر (5432) في DIRECT_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qu_field_training"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/qu_field_training"

# ---------- المصادقة ----------
# توليد مفتاح: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---------- توليد PDF الرسمي على الخادم ----------
# يُكتشف Chrome أو Edge أو Chromium تلقائياً في مساراتها المعتادة (ويندوز/ماك/لينكس).
# حدّد المسار هنا فقط إن كان مثبتاً في مكان آخر. إن لم يوجد متصفح تُفتح نسخة للطباعة (حفظ كـ PDF).
CHROME_EXECUTABLE_PATH=""

# ---------- إعدادات مكافحة التحضير الوهمي ----------
GPS_MAX_ACCURACY_METERS=100
GPS_MAX_POSITION_AGE_SECONDS=120
GPS_ENFORCE_DEVICE_BINDING=true

# ---------- المهام المجدولة ----------
CRON_SECRET="change-me"
# ---------- الشعار الرسمي (PNG/SVG داخل المشروع) ----------
LOGO_PATH="public/brand/qu-logo.png"

# ---------- تخزين المرفقات والأختام ----------
# local (قرص الخادم) أو supabase
STORAGE_DRIVER="local"
STORAGE_DIR="storage"
# عند استخدام Supabase Storage (حاوية خاصة، والمفتاح يبقى على الخادم فقط)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="field-training"
MAX_UPLOAD_BYTES=5242880
